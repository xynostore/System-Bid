<!DOCTYPE html>
<html lang="ms">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>XynoStore Gift Bid</title>
<style>
*{box-sizing:border-box}
body{
  margin:0;background:#0b0714;color:#fff;
  font-family:Arial,sans-serif;padding:20px;
}
main{max-width:650px;margin:auto}
header{text-align:center;padding:20px 0}
.logo{color:#c084fc;font-size:13px;letter-spacing:4px}
h1{font-size:30px;margin:10px 0}
h1 span{color:#c084fc}
.sub{color:#aaa;font-size:13px}
.panel{
  background:#171024;border:1px solid #493064;
  border-radius:18px;padding:18px;margin:14px 0;
}
.timer{text-align:center;font-size:48px;font-weight:bold;color:#d8b4fe}
.status{text-align:center;color:#bca6d6;font-size:13px}
button,input{
  border-radius:10px;border:1px solid #493064;
  padding:12px;background:#241635;color:white;
  font-size:14px;max-width:100%;
}
button{cursor:pointer;font-weight:bold}
.primary{background:#9333ea;border:0}
button:disabled{opacity:.4}
.row{display:flex;gap:8px;flex-wrap:wrap}
.row input{flex:1;min-width:100px}
.row button{flex:1}
h2{font-size:17px;margin-top:0}
table{width:100%;border-collapse:collapse}
th,td{text-align:left;padding:12px 5px;border-bottom:1px solid #332343}
th{font-size:12px;color:#bca6d6}
td{font-size:14px}
.coins{text-align:right;color:#d8b4fe;font-weight:bold}
.rank{width:38px}
.note{font-size:12px;line-height:1.6;color:#aaa}
.winner{text-align:center;color:#f0abfc;font-weight:bold}
footer{text-align:center;color:#777;font-size:11px;padding:20px}
</style>
</head>
<body>
<main>
<header>
  <div class="logo">X Y N O S T O R E</div>
  <h1>GIFT <span>BID</span></h1>
  <div class="sub">HANTAR GIFT • KUMPUL COIN • JADI TOP 1</div>
</header>

<section class="panel">
  <div class="timer" id="timer">03:00</div>
  <div class="status" id="status">BID BELUM DIMULAKAN</div>
  <div class="row" style="margin-top:18px">
    <button class="primary" id="start">MULA BID 3 MINIT</button>
    <button id="reset">RESET</button>
  </div>
  <p class="winner" id="winner"></p>
</section>

<section class="panel">
  <h2>🎁 Tambah Gift / Coin (Demo)</h2>
  <div class="row">
    <input id="username" placeholder="Nama peserta">
    <input id="amount" type="number" min="1"
      step="1" placeholder="Jumlah coin">
    <button class="primary" id="add">TAMBAH</button>
  </div>
  <p class="note">
    Demo sahaja: masukkan nama dan nilai coin secara manual.
    Belum disambungkan kepada gift TikTok LIVE.
  </p>
</section>

<section class="panel">
  <h2>🏆 LEADERBOARD TOP 10</h2>
  <table>
    <thead><tr>
      <th class="rank">#</th><th>PEMENANG BID</th>
      <th style="text-align:right">COIN</th>
    </tr></thead>
    <tbody id="board"></tbody>
  </table>
  <p class="note">Jumlah coin tertinggi berada di tempat pertama.</p>
</section>

<footer>XynoStore © Gift Bid</footer>
</main>
<script>
const $ = id => document.getElementById(id);
let scores = {};
let running = false;
let finished = false;
let endAt = 0;
let interval = null;
let remaining = 180;

function render(){
  const sorted = Object.entries(scores)
    .sort((a,b) => b[1]-a[1] || a[0].localeCompare(b[0]));
  $("board").innerHTML = "";
  if(!sorted.length){
    $("board").innerHTML =
      '<tr><td colspan="3">Belum ada peserta</td></tr>';
    return;
  }
  sorted.slice(0,10).forEach(([name,coin],i)=>{
    const tr = document.createElement("tr");
    [i===0?"👑 "+(i+1):i+1,name,coin.toLocaleString("en-US")].forEach((v,j)=>{
      const td=document.createElement("td");
      td.textContent=v;
      if(j===2)td.className="coins";
      tr.appendChild(td);
    });
    $("board").appendChild(tr);
  });
}

function showTime(seconds){
  seconds=Math.max(0,seconds);
  $("timer").textContent =
    String(Math.floor(seconds/60)).padStart(2,"0")+":"+
    String(seconds%60).padStart(2,"0");
}
function stopBid(){
  running=false;finished=true;
  clearInterval(interval);
  showTime(0);
  $("status").textContent="BID TAMAT";
  $("start").disabled=true;
  const sorted=Object.entries(scores).sort((a,b)=>b[1]-a[1]);
  $("winner").textContent=sorted.length
    ? "🏆 TOP 1: "+sorted[0][0]+" — "+sorted[0][1]+" COIN"
    : "Tiada peserta. Tiada pemenang.";
  $("add").disabled=true;
}
function tick(){
  remaining=Math.ceil((endAt-Date.now())/1000);
  showTime(remaining);
  if(remaining<=0)stopBid();
}
$("start").onclick=()=>{
  if(running||finished)return;
  running=true;
  endAt=Date.now()+remaining*1000;
  $("status").textContent="BID SEDANG BERLANGSUNG";
  $("start").disabled=true;
  interval=setInterval(tick,250);
  tick();
};
$("add").onclick=()=>{
  if(!running)return alert("Mulakan bid dahulu!");
  const name=$("username").value.trim().slice(0,30);
  const coin=Number($("amount").value);
  if(!name||!Number.isSafeInteger(coin)||coin<1)
    return alert("Masukkan nama dan jumlah coin yang sah.");
  scores[name]=(scores[name]||0)+coin;
  $("username").value="";
  $("amount").value="";
  render();
};
$("reset").onclick=()=>{
  if(!confirm("Reset semua skor dan timer?"))return;
  clearInterval(interval);
  scores={};running=false;finished=false;
  remaining=180;endAt=0;interval=null;
  $("status").textContent="BID BELUM DIMULAKAN";
  $("winner").textContent="";
  $("start").disabled=false;
  $("add").disabled=false;
  showTime(180);render();
};
showTime(180);
render();
</script>
</body>
</html>
